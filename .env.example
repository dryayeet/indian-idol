SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Which LLM agent.py talks to: openrouter (default) or gemini
LLM_PROVIDER=gemini

# Provider 1. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model that supports tool calling.
OPENROUTER_MODEL=

# Provider 2. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Gemini model that supports tool calling.
GEMINI_MODEL=
