# Required together for authenticated Spotify tools and OAuth setup.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Required for agent mode, attachment vision, and live model benchmarks.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model that supports tool calling.
# Which model and why: docs/benchmarks/model-bakeoff.md
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23

# Optional. Genres per track, and similar_artists.
# Free key, instant: https://www.last.fm/api/account/create
# Without it, genres fall back to MusicBrainz and similar_artists is unavailable.
LASTFM_API_KEY=

# Optional until the psych tools are used. Free token, read access:
# https://huggingface.co/settings/tokens
HF_TOKEN=
